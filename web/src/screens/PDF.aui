Page PDF
  Row
    Heading level=1 "Your PDF workspace"
    Spacer
    Button action=upload "Upload PDF / images"
    Button variant=secondary action=drive "Open from Drive"
  Field label="Choose PDF, PNG or JPEG files (PDF limit 100 MiB; workspace storage 1 GiB per account)"
    Input name=uploads type=file multiple=true accept="application/pdf,image/png,image/jpeg"
  Alert "Original files are preserved. Annotations and drawing a signature do not create a cryptographically signed PDF. Processed copies can invalidate existing signatures."
  If condition=$exporting
    Button variant=secondary action=cancelExport cancel=true "Cancel browser export"
  Grid columns=2
    Card
      Heading level=2 "Documents"
      For each=$documents
        Row
          Button variant=secondary item=$item.id action=select $item.selection
          Link href=$item.href $item.name
          Text variant=caption $item.sizeLabel
          Button variant=secondary item=$item.id action=open "Open"
          Button variant=secondary item=$item.id action=removeDocument "Remove"
    Card
      Heading level=2 "Tools"
      Select name=operation options=$operations
      Field label="Pages (e.g. 1-3,5; reorder: 3,1,2)"
        Input name=pages
      Field label="Rotation degrees"
        Select name=rotation options=$rotations
      Field label="PDF password (used in memory for this operation only)"
        Input name=pdfPassword type=password
      Button action=process "Process selected PDFs"
      Text variant=caption "Annotated exports are flattened raster copies. Compression is lossless structural optimisation; scanned-image quality is preserved. OCR and Office conversion are not included."
  If condition=$viewing
    Card
      Row variant=pdf-toolbar
        Button variant=secondary action=previous "← Previous"
        Text $pageLabel
        Button variant=secondary action=next "Next →"
        Select name=zoom options=$zooms
        Button variant=secondary action=rotateView "Rotate view"
        Button variant=secondary action=print "Print / browser viewer"
      Row
        Input name=pageNumber type=number min=1 max=$pageCount
        Button variant=secondary action=goPage "Go to page"
      Row variant=thumbnails
        For each=$thumbnails
          Button variant=thumbnail item=$item.page action=match
            Image src=$item.src alt=$item.label width=54
            Text $item.label
      Row
        Input name=find placeholder="Find text in this PDF"
        Button variant=secondary action=find "Find"
        Button variant=secondary action=extractText "Extract text"
        Button variant=secondary action=image "Export page PNG"
      Row
        Select name=tool options=$annotationTools
        Input name=annotationText placeholder="Text / comment / stamp text"
        Button variant=secondary action=undoDrawing "Undo last mark on page"
        Button variant=secondary action=clearDrawings "Clear page marks"
      Field label="Stamp / signature image (PNG or JPEG)"
        Input name=stampUpload type=file accept="image/png,image/jpeg"
      Button variant=secondary action=stampImage "Use stamp image"
      Grid columns=4
        Field label="Mark X (0–1)"
          Input name=markX step=0.01 type=number min=0 max=1
        Field label="Mark Y (0–1)"
          Input name=markY step=0.01 type=number min=0 max=1
        Field label="Mark width (0–1)"
          Input name=markW step=0.01 type=number min=0 max=1
        Field label="Mark height (0–1)"
          Input name=markH step=0.01 type=number min=0 max=1
      Button variant=secondary action=addMark "Add mark using coordinates"
      Section id=pdf-canvas
      Text variant=caption "Drag to draw a rectangle or ink; click for text/comments. Marks are saved per document and account. Black redaction previews become permanent only after Rasterise & redact."
      Row
        Button action=saveAnnotations "Save annotated copy"
        Button variant=danger action=redact "Rasterise & redact"
        Button variant=secondary action=watermark "Watermark copy"
        Button variant=secondary action=screen "Compress: screen-quality copy"
        Button variant=secondary action=numbers "Number pages"
        Button variant=secondary action=metadata "Remove metadata copy"
        Button variant=secondary action=saveDrive "Save selected copy to Drive"
      Field label="Watermark text"
        Input name=watermark
      If condition=$textOutput
        Text variant=pre $textOutput
      For each=$matches
        Button variant=secondary item=$item.page action=match $item.label
  If condition=$driveOpen
    Card
      Heading level=2 "My Drive picker"
      Field label="Your Drive source"
        Select name=driveSource options=$driveSources
      Field label="Folder (inside your allowed scope)"
        Input name=drivePath placeholder="/"
      Button variant=secondary action=listDrive "List folder"
      For each=$driveFiles
        Row
          Text $item.name
          Button variant=secondary item=$item.path action=openDrive $item.action
      Field label="New copy filename"
        Input name=driveName placeholder="edited-document.pdf"
      Text variant=caption "Saving always creates a new file. Existing files are never overwritten."
      Button action=confirmSaveDrive "Confirm: save a new copy"
      Button variant=secondary action=closeDrive "Close picker"
  Card
    Heading level=2 "Jobs"
    For each=$jobs
      Row
        Stack gap=xs
          Text $item.operation
          Text variant=caption $item.message
        Badge $item.state
        Text variant=caption $item.elapsed
        If condition=$item.active
          Spinner
          Button variant=secondary item=$item.id action=cancel "Cancel"
        If condition=$item.openResult
          Button variant=secondary item=$item.result action=open "Open result"
        If condition=$item.downloadURL
          Link href=$item.downloadURL "Download split pages ZIP"
          Button variant=secondary item=$item.result action=removeArtifact "Remove ZIP"
        If condition=$item.metadataText
          Text variant=pre $item.metadataText
